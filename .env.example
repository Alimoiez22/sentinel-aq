# Copy this file to `.env` (`make setup` does it for you). Never commit `.env`.
# These credentials are for a local database on your own machine only.

# Superuser of the PostgreSQL container. Used only by docker/initdb on first start.
POSTGRES_USER=pgadmin
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=postgres
# Host port 5434: Project 1 (AIS warehouse) already uses 5433.
POSTGRES_PORT=5434

# Pipeline role and database (not a superuser).
SENTINEL_DB_USER=sentinel
SENTINEL_DB_PASSWORD=change-me-local-only
SENTINEL_DB_NAME=warehouse
SENTINEL_LOG_LEVEL=INFO

# Airflow metadata role (not a superuser). Database name is fixed: airflow_meta.
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me-local-only
# Signs Airflow's internal API tokens. Any long random string; change it.
AIRFLOW_JWT_SECRET=change-me-local-only-jwt-secret
# Your user id on Linux/macOS (`id -u`). On Windows, 50000 (the image default) is fine.
AIRFLOW_UID=50000

# OpenAQ API key, needed from M1 for the coverage helper (free registration).
OPENAQ_API_KEY=
